MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=ruta_limpia
SESSION_SECRET=cambia-este-secreto
PORT=4000

# Para desarrollo local con Docker, sustituye MONGODB_URI por esta alternativa:
# MONGODB_URI=mongodb://127.0.0.1:27017/ruta_limpia

# Opcional: crea el primer usuario de delegacion al iniciar la API si no existe ningun admin.
FIRST_ADMIN_NAME=Delegacion
FIRST_ADMIN_EMAIL=admin@rutalimpia.local
FIRST_ADMIN_PASSWORD=cambia123

# Opcional si el API se publica en otro dominio.
VITE_API_URL=/api
